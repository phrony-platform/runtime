# Postgres connection for phrony-runtime on the host (see docker-compose.yml)
RUNTIME_DATABASE_URL=postgres://phrony_runtime:phrony_runtime@localhost:5432/phrony_runtime?sslmode=disable

# gRPC listen address when running phrony-runtime on the host (use 0.0.0.0:7777 inside Docker)
RUNTIME_GRPC_ADDR=127.0.0.1:7777

# phrony CLI on the host: connect to the runtime (compose maps 7777 to localhost)
PHRONY_RUNTIME_ADDR=127.0.0.1:7777

# AES-256 master key for encrypting deploy-time secrets (32 bytes, base64). Generate: openssl rand -base64 32
# Required on the runtime when deploying agents that declare a secrets section.
RUNTIME_SECRETS_ENCRYPTION_KEY=

# Dev-only: enable the scripted stub model provider (scenario e2e).
# Prefer `make serve-e2e` (sets this + RUNTIME_DISPATCH_QUEUE_WAIT=10s) over editing .env.
# RUNTIME_ENABLE_STUB_PROVIDER=true

# Max time a tool call may wait in the worker queue when no handler is free (default 10s).
# Scenario e2e (make serve-e2e / e2e compose overlay) uses 10s; general local serve often uses 60s.
RUNTIME_DISPATCH_QUEUE_WAIT=60s
