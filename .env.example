# Postgres connection for phrony-runtime (see docker-compose.yml)
RUNTIME_DATABASE_URL=postgres://phrony_runtime:phrony_runtime@localhost:5432/phrony_runtime?sslmode=disable

# gRPC listen address for phrony-runtime (localhost only by default)
RUNTIME_GRPC_ADDR=127.0.0.1:7777

# phrony CLI: runtime gRPC endpoint (optional override)
PHRONY_RUNTIME_ADDR=127.0.0.1:7777
